# Leave blank to use the GitHub Pages catalogue and WhatsApp enquiries.
# Local development: http://localhost:3001/api
VITE_API_URL=
# Deployment path for GitHub Pages. Use / for a custom domain.
VITE_BASE_PATH=/GumshudaTravellers/
PORT=3001
CLIENT_ORIGIN=https://gumshudatraveller.github.io,http://localhost:5173
DATA_DIR=./data
UPLOAD_DIR=./uploads
# Required to create the initial administrator on the first server start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
